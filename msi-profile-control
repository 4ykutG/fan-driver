#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -Eeuo pipefail

readonly APP_NAME="msi-profile-control"
readonly APP_VERSION="0.2.2"
readonly SYSFS_BASE="${MSI_PROFILE_SYSFS_BASE:-/sys/devices/platform/msi-ec}"
readonly STATE_DIR="${MSI_PROFILE_STATE_DIR:-/run/${APP_NAME}}"
readonly STATE_FILE="${STATE_DIR}/state"
readonly RESULT_FILE="${STATE_DIR}/last-result"
readonly LOCK_FILE="${MSI_PROFILE_LOCK_FILE:-/run/lock/${APP_NAME}.lock}"
readonly PRODUCT_FILE="${MSI_PROFILE_PRODUCT_FILE:-/sys/class/dmi/id/product_name}"
readonly VENDOR_FILE="${MSI_PROFILE_VENDOR_FILE:-/sys/class/dmi/id/sys_vendor}"
readonly TEMP_FILE="${SYSFS_BASE}/cpu/realtime_temperature"
readonly FAN_FILE="${SYSFS_BASE}/fan_mode"
readonly BOOST_FILE="${SYSFS_BASE}/cooler_boost"
readonly MODE_ORDER=(auto silent max)
readonly BOOST_ON_TEMP=90
readonly BOOST_OFF_TEMP=75

die()
{
	printf 'error\tunknown\t0\tunknown\tunknown\t%s\n' "$*"
	exit 1
}

read_one_line()
{
	local value
	IFS= read -r value < "$1"
	printf '%s' "$value"
}

log_info()
{
	logger -t "$APP_NAME" -- "$*" 2>/dev/null || true
}

validate_system()
{
	[[ $(read_one_line "$VENDOR_FILE") == "Micro-Star International Co., Ltd." ]] ||
		die "unsupported vendor"
	[[ $(read_one_line "$PRODUCT_FILE") == "Thin GF63 12VE" ]] ||
		die "unsupported model"
	[[ -r "${SYSFS_BASE}/fw_version" ]] || die "msi-ec is not loaded"
	[[ $(read_one_line "${SYSFS_BASE}/fw_version") == "16R8IMS1.107" ]] ||
		die "unsupported EC firmware"
	[[ -r "$TEMP_FILE" && -w "$FAN_FILE" && -w "$BOOST_FILE" ]] ||
		die "msi-ec fan controls are not writable"
	grep -Fxq 'auto' "${SYSFS_BASE}/available_fan_modes" ||
		die "auto fan mode is unavailable"
	grep -Fxq 'silent' "${SYSFS_BASE}/available_fan_modes" ||
		die "silent fan mode is unavailable"
}

temperature()
{
	local temp
	temp=$(read_one_line "$TEMP_FILE")
	[[ $temp =~ ^[0-9]+$ ]] || die "invalid CPU temperature"
	printf '%s' "$temp"
}

current_mode()
{
	local saved fan
	if [[ -r $STATE_FILE ]]; then
		saved=$(read_one_line "$STATE_FILE")
		case "$saved" in
			auto|silent|max) printf '%s' "$saved"; return ;;
		esac
	fi

	# Hardware fallback, reached whenever no valid choice has been recorded:
	# on first run, after a 0.1.x profile name is left behind, and on every
	# boot, because the state file lives on tmpfs.
	#
	# cooler_boost is deliberately not read here. The guard turns it on by
	# itself above BOOST_ON_TEMP, so treating it as evidence of a user choice
	# latches the machine: boost on is read back as max, max forces boost on
	# at the next guard tick, and nothing short of an explicit set ever breaks
	# the loop. Only fan_mode describes a mode the guard does not force.
	fan=$(read_one_line "$FAN_FILE")
	if [[ $fan == silent ]]; then
		printf 'silent'
	else
		printf 'auto'
	fi
}

next_mode()
{
	local current=$1 i count=${#MODE_ORDER[@]}
	for i in "${!MODE_ORDER[@]}"; do
		if [[ ${MODE_ORDER[i]} == "$current" ]]; then
			printf '%s' "${MODE_ORDER[(i + 1) % count]}"
			return
		fi
	done
	printf 'auto'
}

write_value()
{
	local file=$1 value=$2
	if [[ $(read_one_line "$file") != "$value" ]]; then
		printf '%s\n' "$value" > "$file"
	fi
}

record_state()
{
	printf '%s\n' "$1" > "$STATE_FILE"
}

# Automatic mode uses a 90/75 C hysteresis. Silent and Maximum Fan are
# explicit locks and never call this helper.
safe_boost()
{
	local temp=$1 current_boost=$2
	if (( temp >= BOOST_ON_TEMP )) ||
		{ [[ $current_boost == on ]] && (( temp > BOOST_OFF_TEMP )); }; then
		printf 'on'
	else
		printf 'off'
	fi
}

apply_mode()
{
	local mode=$1 temp=$2 fan boost message=ok
	case "$mode" in
		auto)
			fan=auto
			boost=$(safe_boost "$temp" "$(read_one_line "$BOOST_FILE")")
			;;
		silent)
			fan=silent
			boost=off
			;;
		max)
			fan=auto
			boost=on
			;;
		*) die "invalid fan mode" ;;
	esac

	write_value "$FAN_FILE" "$fan"
	write_value "$BOOST_FILE" "$boost"
	record_state "$mode"
	if [[ $mode == auto && $boost == on && $temp -ge $BOOST_ON_TEMP ]]; then
		message="90°C üzeri: Cooler Boost"
	fi
	printf 'applied\t%s\t%s\t%s\t%s\t%s\n' \
		"$mode" "$temp" "$fan" "$boost" "$message"
}

thermal_guard()
{
	local temp mode fan boost changed=0 message=ok
	temp=$(temperature)
	mode=$(current_mode)
	fan=$(read_one_line "$FAN_FILE")
	boost=$(read_one_line "$BOOST_FILE")

	if [[ $mode == max ]]; then
		[[ $fan == auto ]] || { write_value "$FAN_FILE" auto; changed=1; }
		[[ $boost == on ]] || { write_value "$BOOST_FILE" on; changed=1; }
	elif [[ $mode == silent ]]; then
		[[ $fan == silent ]] || { write_value "$FAN_FILE" silent; changed=1; }
		[[ $boost == off ]] || { write_value "$BOOST_FILE" off; changed=1; }
		(( changed == 0 )) || log_info "restored locked silent fan mode"
	elif (( temp >= BOOST_ON_TEMP )); then
		[[ $boost == on ]] || { write_value "$BOOST_FILE" on; changed=1; }
		message="90°C üzeri: Cooler Boost"
		(( changed == 0 )) || log_info "CPU ${temp} C; Cooler Boost forced on"
	elif (( temp <= BOOST_OFF_TEMP )); then
		[[ $boost == off ]] || {
			write_value "$BOOST_FILE" off
			changed=1
			message="Soğudu: ${mode} fan modu"
		}
		if [[ $fan != auto ]]; then
			write_value "$FAN_FILE" auto
			changed=1
		fi
		(( changed == 0 )) || log_info "CPU ${temp} C; restored ${mode} fan mode"
	fi

	printf 'status\t%s\t%s\t%s\t%s\t%s\n' \
		"$mode" "$temp" "$(read_one_line "$FAN_FILE")" \
		"$(read_one_line "$BOOST_FILE")" "$message"
}

status()
{
	printf 'status\t%s\t%s\t%s\t%s\tok\n' \
		"$(current_mode)" "$(temperature)" \
		"$(read_one_line "$FAN_FILE")" "$(read_one_line "$BOOST_FILE")"
}

save_result()
{
	printf '%s\n' "$1" > "$RESULT_FILE"
	chmod 0644 "$RESULT_FILE"
	printf '%s\n' "$1"
}

main()
{
	local output
	if [[ ${1:-} == --version || ${1:-} == version ]]; then
		printf '%s %s\n' "$APP_NAME" "$APP_VERSION"
		return
	fi

	if [[ ${MSI_PROFILE_TESTING:-0} != 1 ]]; then
		[[ ${EUID} -eq 0 ]] || die "root privileges required"
	fi
	umask 077
	install -d -m 0755 "$STATE_DIR"
	exec 9> "$LOCK_FILE"
	flock -x 9
	validate_system

	case "${1:-}" in
		set)
			case "${2:-}" in auto|silent|max) ;; *)
				die "usage: ${APP_NAME} set {auto|silent|max}" ;;
			esac
			output=$(apply_mode "$2" "$(temperature)")
			save_result "$output"
			;;
		cycle)
			output=$(apply_mode "$(next_mode "$(current_mode)")" "$(temperature)")
			save_result "$output"
			;;
		guard) thermal_guard ;;
		status) status ;;
		*) die "usage: ${APP_NAME} {set <mode>|cycle|guard|status|version}" ;;
	esac
}

main "$@"
