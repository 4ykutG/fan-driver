"""Privacy-safe live fan and thermal telemetry recorder."""

import argparse
import csv
import os
import pathlib
import sys
import time

ROOT = pathlib.Path(os.environ.get('MSI_PROFILE_MONITOR_ROOT', '/'))
FIELDS = (
    'elapsed_s', 'selected_fan_mode', 'fan_mode', 'cooler_boost',
    'cpu_temp_c', 'ec_cpu_fan_percent', 'cpu_fan_rpm',
    'ec_gpu_temp_c', 'ec_gpu_fan_percent',
)


def rooted(path):
    return ROOT / path.lstrip('/')


def read(path):
    try:
        return rooted(path).read_text(encoding='utf-8').strip()
    except OSError:
        return ''


def hwmon_cpu_fan_rpm():
    try:
        for device in rooted('/sys/class/hwmon').glob('hwmon*'):
            try:
                if (device / 'name').read_text().strip() == 'msi_wmi_platform':
                    return (device / 'fan1_input').read_text().strip()
            except OSError:
                continue
    except OSError:
        pass
    return ''


def sample(elapsed):
    base = '/sys/devices/platform/msi-ec'
    return {
        'elapsed_s': f'{elapsed:.2f}',
        'selected_fan_mode': read('/run/msi-profile-control/state'),
        'fan_mode': read(f'{base}/fan_mode'),
        'cooler_boost': read(f'{base}/cooler_boost'),
        'cpu_temp_c': read(f'{base}/cpu/realtime_temperature'),
        'ec_cpu_fan_percent': read(f'{base}/cpu/realtime_fan_speed'),
        'cpu_fan_rpm': hwmon_cpu_fan_rpm(),
        'ec_gpu_temp_c': read(f'{base}/gpu/realtime_temperature'),
        'ec_gpu_fan_percent': read(f'{base}/gpu/realtime_fan_speed'),
    }


def bounded_float(value, minimum, maximum):
    number = float(value)
    if not minimum <= number <= maximum:
        raise argparse.ArgumentTypeError(
            f'value must be between {minimum} and {maximum}')
    return number


def main():
    parser = argparse.ArgumentParser(
        description='Record anonymous MSI EC fan telemetry as CSV.')
    parser.add_argument(
        '--duration', type=lambda value: bounded_float(value, 1, 86400),
        default=60.0, help='recording duration in seconds (default: 60)')
    parser.add_argument(
        '--interval', type=lambda value: bounded_float(value, 0.5, 60),
        default=2.0, help='sample interval in seconds (default: 2)')
    parser.add_argument('-o', '--output', type=pathlib.Path,
                        help='output path; stdout when omitted')
    parser.add_argument('--force', action='store_true',
                        help='replace an existing output file')
    args = parser.parse_args()

    output = sys.stdout
    close_output = False
    if args.output:
        mode = 'w' if args.force else 'x'
        try:
            output = args.output.open(mode, encoding='utf-8', newline='')
        except FileExistsError:
            parser.error('output exists; use --force to replace it')
        close_output = True

    try:
        writer = csv.DictWriter(output, fieldnames=FIELDS)
        writer.writeheader()
        output.flush()
        started = time.monotonic()
        next_sample = started
        while True:
            now = time.monotonic()
            elapsed = now - started
            writer.writerow(sample(elapsed))
            output.flush()
            next_sample += args.interval
            if next_sample - started > args.duration:
                break
            time.sleep(max(0.0, next_sample - time.monotonic()))
    finally:
        if close_output:
            output.close()
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
