"""Fn+F7 fan-mode daemon for the MSI Thin GF63 12VE.

The daemon only asks the backend to change fan_mode and cooler_boost. It does
not inspect games and never changes CPU, GPU, MSI Shift or desktop power modes.
"""

import configparser
import json
import os
import selectors
import struct
import subprocess
import sys
import syslog
import time

KEY_PROG3 = 202
EV_KEY = 1
KEY_DOWN = 1
INPUT_EVENT = struct.Struct('llHHi')

BACKEND = os.environ.get(
    'MSI_PROFILE_BACKEND', '/usr/local/sbin/msi-profile-control')
STATE_DIR = os.environ.get(
    'MSI_PROFILE_STATE_DIR', '/run/msi-profile-control')
OSD_STATE_FILE = os.path.join(STATE_DIR, 'osd-state')
CONFIG_FILE = os.environ.get(
    'MSI_PROFILE_CONFIG', '/etc/msi-profile-control.conf')
SYS_INPUT = os.environ.get('MSI_PROFILE_SYS_INPUT', '/sys/class/input')
DEV_INPUT = os.environ.get('MSI_PROFILE_DEV_INPUT', '/dev/input')

MODE_ORDER = ('auto', 'silent', 'max')
COMMIT_DELAY = 0.9
PRESS_DEBOUNCE = 0.12
GUARD_INTERVAL = 15.0
RESCAN_INTERVAL = 30.0


def log(message, priority=syslog.LOG_INFO):
    syslog.syslog(priority, message)


def read_settings():
    """Read the bounded thermal-guard interval without executing config."""
    parser = configparser.ConfigParser(interpolation=None)
    try:
        with open(CONFIG_FILE, encoding='utf-8') as config_file:
            parser.read_file(config_file)
        value = parser.getfloat('daemon', 'guard_interval')
    except (OSError, configparser.Error, ValueError):
        return {'guard_interval': GUARD_INTERVAL}
    if not 5.0 <= value <= 120.0:
        value = GUARD_INTERVAL
    return {'guard_interval': value}


def find_prog3_devices():
    """Return input devices whose key capability includes KEY_PROG3."""
    devices = []
    try:
        entries = sorted(os.listdir(SYS_INPUT))
    except OSError:
        return devices
    for entry in entries:
        if not entry.startswith('event'):
            continue
        cap_path = os.path.join(SYS_INPUT, entry, 'device',
                                'capabilities', 'key')
        try:
            with open(cap_path, encoding='ascii') as cap_file:
                words = cap_file.read().split()
            words.reverse()
            word, bit = divmod(KEY_PROG3, 64)
            if word < len(words) and (int(words[word], 16) >> bit) & 1:
                devices.append(os.path.join(DEV_INPUT, entry))
        except (OSError, ValueError):
            continue
    return devices


def run_backend(*args):
    """Run the fan backend and parse its six-field result."""
    try:
        completed = subprocess.run(
            [BACKEND, *args], capture_output=True, text=True,
            timeout=15, check=False)
    except (OSError, subprocess.TimeoutExpired) as error:
        log(f'backend {args[0]} failed: {error}', syslog.LOG_ERR)
        return None
    lines = completed.stdout.strip().splitlines()
    fields = lines[-1].split('\t') if lines else []
    if len(fields) != 6:
        detail = completed.stderr.strip() or completed.stdout.strip()
        log(f'backend {args[0]} produced no result: {detail}', syslog.LOG_ERR)
        return None
    result = dict(zip(
        ('result', 'mode', 'temp', 'fan', 'boost', 'message'), fields))
    # Keep the old key during the 0.1 -> 0.2 OSD protocol transition.
    result['profile'] = result['mode']
    if result['result'] == 'error':
        log(f'backend {args[0]} error: {result["message"]}', syslog.LOG_ERR)
        return None
    return result


class HotkeyDaemon:
    def __init__(self):
        settings = read_settings()
        self.selector = selectors.DefaultSelector()
        self.open_devices = {}
        self.sequence = 0
        self.current = 'auto'
        self.pending = None
        self.commit_at = None
        self.guard_interval = settings['guard_interval']
        self.guard_at = time.monotonic() + self.guard_interval
        self.rescan_at = 0.0
        self.last_press = 0.0
        self.last_boost = None

    def publish(self, phase, **extra):
        self.sequence += 1
        state = {'phase': phase, 'seq': self.sequence, 'ts': time.time()}
        state.update(extra)
        os.makedirs(STATE_DIR, exist_ok=True)
        temp_path = OSD_STATE_FILE + '.tmp'
        with open(temp_path, 'w', encoding='utf-8') as state_file:
            json.dump(state, state_file, ensure_ascii=False)
            state_file.write('\n')
        os.chmod(temp_path, 0o644)
        os.replace(temp_path, OSD_STATE_FILE)

    def publish_result(self, phase, result):
        self.publish(phase, mode=result['mode'], profile=result['mode'],
                     temp=result['temp'], fan=result['fan'],
                     boost=result['boost'], message=result['message'])

    def open_input_devices(self):
        wanted = find_prog3_devices()
        for path in wanted:
            if path in self.open_devices:
                continue
            try:
                fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK)
            except OSError as error:
                log(f'cannot open {path}: {error}', syslog.LOG_WARNING)
                continue
            self.selector.register(fd, selectors.EVENT_READ, path)
            self.open_devices[path] = fd
            log(f'listening for KEY_PROG3 on {path}')
        self.rescan_at = time.monotonic() + RESCAN_INTERVAL

    def close_device(self, path):
        fd = self.open_devices.pop(path, None)
        if fd is None:
            return
        try:
            self.selector.unregister(fd)
        except KeyError:
            pass
        os.close(fd)

    def drain_device(self, fd, path):
        pressed = False
        while True:
            try:
                chunk = os.read(fd, INPUT_EVENT.size * 64)
            except BlockingIOError:
                break
            except OSError:
                self.close_device(path)
                return False
            if not chunk:
                self.close_device(path)
                return False
            for offset in range(0, len(chunk) - INPUT_EVENT.size + 1,
                                INPUT_EVENT.size):
                _sec, _usec, event_type, code, value = \
                    INPUT_EVENT.unpack_from(chunk, offset)
                if (event_type == EV_KEY and code == KEY_PROG3 and
                        value == KEY_DOWN):
                    pressed = True
        return pressed

    def handle_press(self):
        now = time.monotonic()
        if now - self.last_press < PRESS_DEBOUNCE:
            return
        self.last_press = now
        base = self.pending if self.pending is not None else self.current
        index = MODE_ORDER.index(base) if base in MODE_ORDER else 0
        self.pending = MODE_ORDER[(index + 1) % len(MODE_ORDER)]
        self.commit_at = now + COMMIT_DELAY
        self.publish('preview', selected=self.pending, current=self.current)

    def commit(self):
        target, self.pending, self.commit_at = self.pending, None, None
        result = run_backend('set', target)
        if result is None:
            self.publish('error', message='Fan modu uygulanamadı')
            return
        self.current = result['mode']
        self.last_boost = result['boost']
        self.publish_result('applied', result)

    def run_guard(self):
        self.guard_at = time.monotonic() + self.guard_interval
        if self.pending is not None:
            return
        old_boost = self.last_boost
        result = run_backend('guard')
        if result is None:
            return
        self.current = result['mode']
        self.last_boost = result['boost']
        # Only Automatic mode can change boost thermally. Show that transition.
        if old_boost is not None and old_boost != result['boost']:
            self.publish_result('applied', result)

    def sync_current(self):
        result = run_backend('status')
        if result is not None:
            self.current = result['mode']
            self.last_boost = result['boost']
            result['message'] = 'Hazır'
            self.publish_result('sync', result)

    def run(self):
        syslog.openlog('msi-profile-hotkeyd')
        self.sync_current()
        self.open_input_devices()
        if not self.open_devices:
            log('no input device exposes KEY_PROG3 yet; will keep scanning',
                syslog.LOG_WARNING)

        while True:
            now = time.monotonic()
            deadlines = [self.guard_at, self.rescan_at]
            if self.commit_at is not None:
                deadlines.append(self.commit_at)
            timeout = max(0.0, min(deadlines) - now)
            pressed = any(
                self.drain_device(key.fd, key.data)
                for key, _mask in self.selector.select(timeout))
            if pressed:
                self.handle_press()

            now = time.monotonic()
            if self.commit_at is not None and now >= self.commit_at:
                self.commit()
            if now >= self.guard_at:
                self.run_guard()
            if now >= self.rescan_at:
                self.open_input_devices()


def main():
    if os.geteuid() != 0:
        print('msi-profile-hotkeyd must run as root', file=sys.stderr)
        return 1
    HotkeyDaemon().run()
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
