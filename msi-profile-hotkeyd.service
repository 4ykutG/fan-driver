[Unit]
Description=MSI GF63 Fn+F7 fan mode daemon
ConditionPathExists=/sys/devices/platform/msi-ec/fan_mode

[Service]
Type=simple
ExecStart=/usr/bin/python3 /usr/local/sbin/msi-profile-hotkeyd
Restart=on-failure
RestartSec=2
Nice=5
CPUWeight=50
IOSchedulingClass=idle
RuntimeDirectory=msi-profile-control
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictRealtime=yes
ReadWritePaths=/sys/devices/platform/msi-ec /run/msi-profile-control /run/lock

[Install]
WantedBy=multi-user.target
