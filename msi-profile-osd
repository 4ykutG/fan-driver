"""MSI Center-style on-screen display for the Fn+F7 fan controller.

Watches /run/msi-profile-control/osd-state and shows a three-mode
selector panel. On compositors that implement wlr-layer-shell (KDE,
Hyprland, Sway, ...) the panel is a true overlay via gtk4-layer-shell;
elsewhere it falls back to a plain undecorated window. On GNOME the
bundled shell extension draws the panel instead, so this daemon steps
aside when that extension is enabled.
"""

import json
import os
import sys

import gi

gi.require_version('Gtk', '4.0')
gi.require_version('Gdk', '4.0')
from gi.repository import Gdk, Gio, GLib, Gtk  # noqa: E402

try:
    gi.require_version('Gtk4LayerShell', '1.0')
    from gi.repository import Gtk4LayerShell as LayerShell
except (ValueError, ImportError):
    LayerShell = None

STATE_FILE = '/run/msi-profile-control/osd-state'
HIDE_DELAY_MS = 1800

