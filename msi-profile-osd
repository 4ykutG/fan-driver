def gnome_shell_active():
    """Use only the Shell extension on GNOME, never the GTK fallback too."""
    desktops = ':'.join((
        os.environ.get('XDG_CURRENT_DESKTOP', ''),
        os.environ.get('XDG_SESSION_DESKTOP', ''),
    ))
    return 'GNOME' in desktops.upper()


class OsdApplication(Gtk.Application):
    def __init__(self):
        super().__init__(application_id='org.local.MsiProfileOsd',
                         flags=Gio.ApplicationFlags.DEFAULT_FLAGS)
        self.window = None
        self.cards = {}
        self.status_label = None
        self.hide_source = 0
        self.last_seq = None
        self.monitor = None

    def do_startup(self):
        Gtk.Application.do_startup(self)
        self.hold()

        provider = Gtk.CssProvider()
        provider.load_from_data(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider,
            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        self._build_window()
        self._prewarm_window()
        self._read_state(initial=True)

        state_file = Gio.File.new_for_path(STATE_FILE)
        self.monitor = state_file.monitor_file(
            Gio.FileMonitorFlags.WATCH_MOVES, None)
        self.monitor.set_rate_limit(50)
        self.monitor.connect('changed', self._on_state_changed)

    def do_activate(self):
        pass

    def _build_window(self):
        self.window = Gtk.Window(application=self, decorated=False,
                                 resizable=False)
        self.window.add_css_class('msi-profile-osd')

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        panel.add_css_class('msi-profile-panel')

        title = Gtk.Label(label='MSI FAN CONTROL')
        title.add_css_class('msi-profile-title')
        panel.append(title)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12,
                      halign=Gtk.Align.CENTER)
        for profile in MODES:
            card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
            card.add_css_class('msi-profile-card')
            card.append(self._make_icon(profile['id']))
            name = Gtk.Label(label=profile['name'])
            name.add_css_class('msi-profile-name')
            card.append(name)
            row.append(card)
            self.cards[profile['id']] = card
        panel.append(row)

        self.status_label = Gtk.Label(label='')
        self.status_label.add_css_class('msi-profile-status')
        panel.append(self.status_label)

        self.window.set_child(panel)

        if LayerShell is not None and LayerShell.is_supported():
            LayerShell.init_for_window(self.window)
            LayerShell.set_layer(self.window, LayerShell.Layer.OVERLAY)
            LayerShell.set_namespace(self.window, 'msi-profile-osd')
            LayerShell.set_keyboard_mode(self.window,
                                         LayerShell.KeyboardMode.NONE)

    @staticmethod
    def _make_icon(profile_id):
        try:
            texture = Gdk.Texture.new_from_bytes(
                GLib.Bytes.new(ICON_SVG[profile_id].encode()))
            picture = Gtk.Picture.new_for_paintable(texture)
            picture.set_can_shrink(True)
            picture.set_size_request(44, 44)
            picture.set_halign(Gtk.Align.CENTER)
            return picture
        except GLib.Error:
            return Gtk.Image.new_from_icon_name('application-x-executable-symbolic')

    def _prewarm_window(self):
        # The very first map of a GTK window is expensive (renderer setup,
        # ~2s on this machine). Map it invisibly once at startup so the
        # first real keypress shows the panel instantly.
        self.window.set_opacity(0)
        self.window.set_visible(True)
        GLib.timeout_add(300, self._finish_prewarm)

    def _finish_prewarm(self):
        if self.window.get_opacity() == 0:
            self.window.set_visible(False)
            self.window.set_opacity(1)
        return GLib.SOURCE_REMOVE

    def _on_state_changed(self, _monitor, _file, _other, event):
        if event in (Gio.FileMonitorEvent.CHANGES_DONE_HINT,
                     Gio.FileMonitorEvent.CREATED,
                     Gio.FileMonitorEvent.MOVED_IN,
                     Gio.FileMonitorEvent.RENAMED):
            self._read_state()

    def _read_state(self, initial=False):
        try:
            with open(STATE_FILE, encoding='utf-8') as state_file:
                state = json.load(state_file)
        except (OSError, ValueError):
            return
        seq = state.get('seq')
        if seq == self.last_seq:
            return
        self.last_seq = seq
        if initial:
            return
        self._render(state)

    def _render(self, state):
        phase = state.get('phase')
        highlight = state.get('selected') if phase == 'preview' \
            else state.get('mode', state.get('profile'))

        for profile_id, card in self.cards.items():
            card.remove_css_class('msi-profile-card-active')
            card.remove_css_class(f'msi-active-{profile_id}')
            if profile_id == highlight:
                card.add_css_class('msi-profile-card-active')
                card.add_css_class(f'msi-active-{profile_id}')

        self.status_label.remove_css_class('msi-profile-warning')
        if phase == 'preview':
            self.status_label.set_label('Seçmek için Fn+F7 • bırakınca uygulanır')
        elif phase == 'error':
            self.status_label.add_css_class('msi-profile-warning')
            self.status_label.set_label(state.get('message', 'Hata'))
        else:
            if state.get('boost') == 'on':
                fan = 'Maksimum'
            elif state.get('fan') == 'silent':
                fan = 'Sessiz'
            else:
                fan = 'Otomatik'
            message = state.get('message', '')
            suffix = f"  •  {message}" if message and message != 'ok' else ''
            self.status_label.set_label(
                f"CPU {state.get('temp', '?')}°C  •  Fan {fan}{suffix}")

        self.window.set_opacity(1)
        self.window.set_visible(True)
        if self.hide_source:
            GLib.source_remove(self.hide_source)
            self.hide_source = 0
        if phase != 'preview':
            self.hide_source = GLib.timeout_add(HIDE_DELAY_MS, self._hide)

    def _hide(self):
        self.hide_source = 0
        self.window.set_visible(False)
        return GLib.SOURCE_REMOVE


def main():
    if gnome_shell_active():
        print('msi-profile-osd: GNOME uses the Shell extension; exiting.')
        return 0
    app = OsdApplication()
    return app.run(sys.argv)


if __name__ == '__main__':
    sys.exit(main())
