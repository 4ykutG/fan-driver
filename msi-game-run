#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0-or-later
set -Eeuo pipefail

# GameMode supplies per-process CPU/I/O optimisations. prime-run makes NVIDIA
# the only Vulkan device visible so hybrid-GPU games cannot choose Intel.
# The fallback keeps games launchable before the optional packages are present.
if [[ -x /usr/bin/gamemoderun ]]; then
	exec /usr/bin/gamemoderun /usr/bin/prime-run "$@"
fi
exec /usr/bin/prime-run "$@"
